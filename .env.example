DATABASE_URL=sqlite:///./skeleton_growth.db
MASTER_PROJECT_FOLDER=I:\YouTube Projects
API_BASE_URL=http://127.0.0.1:8000
# Used by the Vite development server; the API accepts only the two local port-5173 origins.
VITE_API_BASE_URL=http://127.0.0.1:8000
YOUTUBE_CLIENT_SECRET_PATH=C:\secure\youtube-oauth-client.json
# Mandatory: absolute path outside this repository; the app enforces owner-only ACLs.
YOUTUBE_TOKEN_PATH=C:\Users\YOUR_NAME\AppData\Local\SkeletonCoastGrowthDashboard\youtube-token.json
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8000/youtube/oauth/callback
# Required safety gate: the sole channel V1 may ingest.
EXPECTED_YOUTUBE_CHANNEL_ID=UC_REPLACE_WITH_SKELETON_COAST_CHANNEL_ID
